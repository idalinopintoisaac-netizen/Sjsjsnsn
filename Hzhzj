tbl2.updateLoopUI = function()
	if not tbl2.loopBox or not tbl2.loopBox.Parent then
		return
	end

	if tbl4.loopEnabled then
		tbl2.loopBox.BackgroundColor3 = BLUE_PRIMARY
		tbl2.loopBoxStroke.Color = CYAN
		tbl2.loopCheck.Visible = true
		tbl2.loopLabel.TextColor3 = CYAN
	else
		tbl2.loopBox.BackgroundColor3 = BLUE_DARK
		tbl2.loopBoxStroke.Color = BLUE_LIGHT
		tbl2.loopCheck.Visible = false
		tbl2.loopLabel.TextColor3 = TEXT_MUTED
	end
end

tbl2.updateToggle = function()
	if tbl4.enabled then
		TweenService:Create(frame9, TweenInfo.new(0.18, Enum.EasingStyle.Quart), { BackgroundColor3 = BLUE_PRIMARY }):Play()
		TweenService:Create(frame10, TweenInfo.new(0.18, Enum.EasingStyle.Quart), { Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = TEXT_WHITE }):Play()
		uiStroke6.Color = CYAN

		if tbl4.waitingForDay then
			textLabel9.Text = tbl2.isDaytime() and "WAITING FOR GATE" or "WAITING FOR DAY"
		elseif tbl4.runLoop then
			textLabel9.Text = "LOOP ACTIVE"
		else
			textLabel9.Text = "ONE SHOT IN PROGRESS"
		end
	else
		TweenService:Create(frame9, TweenInfo.new(0.18, Enum.EasingStyle.Quart), { BackgroundColor3 = BLUE_DARK }):Play()
		TweenService:Create(frame10, TweenInfo.new(0.18, Enum.EasingStyle.Quart), { Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = TEXT_MUTED }):Play()
		uiStroke6.Color = BLUE_PRIMARY
		textLabel9.Text = tbl4.loopEnabled and "LOOP READY" or "ONE SHOT"
	end
end

